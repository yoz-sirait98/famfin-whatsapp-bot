# Required: PostgreSQL connection string (Supabase or any Postgres provider)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: Secret key to authenticate requests from Supabase Webhooks / final-finance-family
# Generate with: node -e "console.log(require('crypto').randomUUID())"
API_KEY=your_super_secret_api_key_here

# Optional: Identifier for the WhatsApp session stored in PostgreSQL. Default: "famfin"
SESSION_ID=famfin

# Optional: Port for the API server. Default: 3000
PORT=3000

# Optional: Web Push (PWA notifications) — leave blank to disable /api/push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@famfin.app
